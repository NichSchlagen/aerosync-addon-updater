{
  "name": "aerosync-addon-updater",
  "version": "2.1.3",
  "description": "Desktop updater for X-Plane add-ons with support for X-Updater and iniBuilds",
  "main": "main.js",
  "private": true,
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "author": {
    "name": "Tim Rosenhagen",
    "email": "49558999+NichSchlagen@users.noreply.github.com"
  },
  "scripts": {
    "start": "electron .",
    "start:linux": "env -u ELECTRON_RUN_AS_NODE electron .",
    "smoke": "electron --no-sandbox scripts/smoke-test.js",
    "smoke:linux": "env -u ELECTRON_RUN_AS_NODE electron --no-sandbox scripts/smoke-test.js",
    "pack": "electron-builder --dir",
    "build:appimage": "electron-builder --linux AppImage",
    "build:win": "npm run build:win:setup && npm run build:win:portable",
    "build:win:setup": "electron-builder --win nsis",
    "build:win:portable": "electron-builder --win portable",
    "build:deb": "electron-builder --linux deb",
    "build:rpm": "electron-builder --linux rpm",
    "build:linux": "npm run build:appimage && npm run build:deb && npm run build:rpm"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.aerosync.addonupdater",
    "productName": "AeroSync Addon Updater",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "languages/**/*",
      "package.json",
      "build/icons/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icons/linux",
      "maintainer": "Tim Rosenhagen <49558999+NichSchlagen@users.noreply.github.com>"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "languages",
        "to": "languages",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icons",
        "to": "build/icons",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    }
  }
}
